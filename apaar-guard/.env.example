# APAAR GUARD Prototype Configuration
APP_NAME="APAAR Guard"
APP_ENV=development
SECRET_KEY=demo-insecure-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite prototype (PostgreSQL compatible connection string syntax)
DATABASE_URL=sqlite:///./apaar_guard.db

# Frontend CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Verification Mock Settings
OFFICIAL_VERIFICATION_ENABLED=false

